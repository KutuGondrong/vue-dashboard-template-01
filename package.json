{
  "name": "vue-dashboard-template-01",
  "private": true,
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build": "vue-tsc --noEmit && vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint src && vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\" \"scripts/**/*.{ts,vue,mjs,json,md}\" && eslint src scripts/template --fix",
    "precommit": "lint-staged && vue-tsc --noEmit",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "volta": {
    "node": "22.23.1",
    "pnpm": "11.17.0"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "pinia": "^2.3.1",
    "vue": "3.5.38",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.64.0",
    "vite": "^5.4.11",
    "vue-tsc": "^2.2.0"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "scripts/template/**/*.{ts,vue}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{css,json}": "prettier --write",
    "scripts/**/*.{mjs,json,md}": "prettier --write"
  }
}
